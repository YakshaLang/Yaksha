import libs.strings.array as sarr
import libs.strings
import libs.fileformats.toml
import libs.os
import libs.os.path
import libs.io
import libs.console

struct ZigVersion:
    major: int
    minor: int
    patch: int

def zig_version_at_least(v: ZigVersion, major: int, minor: int) -> bool:
    if v.major > major:
        return True
    if v.major < major:
        return False
    return v.minor >= minor

def default_zig_version() -> ZigVersion:
    return ZigVersion{major: 0, minor: 9, patch: 1}

@native
def atoi_component(s: sr) -> int:
    ccode """return (int32_t)atoi(yk__bstr_get_reference(nn__s));"""

def parse_zig_version_line(line: str) -> ZigVersion:
    v: ZigVersion = ZigVersion{major: 0, minor: 0, patch: 0}
    parts: Array[str] = strings.split(line, ".")
    defer sarr.del_str_array(parts)
    if len(parts) >= 1:
        v.major = atoi_component(parts[0])
    if len(parts) >= 2:
        v.minor = atoi_component(parts[1])
    if len(parts) >= 3:
        v.patch = atoi_component(parts[2])
    return v

def query_zig_version(zig_path: str) -> ZigVersion:
    args: Array[str] = array("str", zig_path, "version")
    defer sarr.del_str_array(args)
    pr: os.ProcessResult = os.run(args)
    defer os.del_process_result(pr)
    if not pr.ok or len(pr.output) == 0:
        console.yellow("warning: failed to query zig version, assuming 0.9.1\n")
        return default_zig_version()
    output: str = pr.output
    nl: int = strings.find_char(output, strings.ord("\n"))
    if nl >= 0:
        output = strings.mid(output, 0, nl)
    return parse_zig_version_line(output)

def macos_abi_for_zig(v: ZigVersion) -> str:
    if zig_version_at_least(v, 0, 10):
        return "none"
    return "gnu"

@native
def host_cpu_arch() -> str:
    ccode """
    #if defined(__aarch64__) || defined(__arm64__) || defined(__arm64__)
        return yk__sdsnew("aarch64");
    #elif defined(__i386__) || defined(__i686__)
        return yk__sdsnew("i386");
    #else
        return yk__sdsnew("x86_64");
    #endif
    """

@native
def host_uses_musl() -> bool:
    ccode """
    #if defined(__linux__) && !defined(__GLIBC__) && !defined(__gnu_linux__)
        return true;
    #else
        return false;
    #endif
    """

def resolve_native_triple(zig_path: sr) -> str:
    arch: str = host_cpu_arch()
    ver: ZigVersion = query_zig_version(zig_path)
    if os.is_macos():
        abi: str = macos_abi_for_zig(ver)
        return arch + "-macos-" + abi
    if os.is_windows():
        return arch + "-windows-gnu"
    libc: str = "gnu"
    if host_uses_musl():
        libc = "musl"
    return arch + "-linux-" + libc

def normalize_zig_triple(triple: sr, zig_path: sr) -> str:
    ver: ZigVersion = query_zig_version(zig_path)
    abi: str = macos_abi_for_zig(ver)
    gnu_suffix: str = "-macos-gnu"
    none_suffix: str = "-macos-none"
    if abi == "none" and strings.endswith(triple, gnu_suffix):
        base: str = strings.mid(triple, 0, len(triple) - len(gnu_suffix))
        return base + none_suffix
    if abi == "gnu" and strings.endswith(triple, none_suffix):
        base: str = strings.mid(triple, 0, len(triple) - len(none_suffix))
        return base + gnu_suffix
    return triple

def effective_zig_target(config_target: str, zig_path: sr) -> str:
    if config_target == "native":
        return resolve_native_triple(zig_path)
    return normalize_zig_triple(config_target, zig_path)

def needs_dynamic_linking(config_target: str, zig_path: sr) -> bool:
    zig_target: str = effective_zig_target(config_target, zig_path)
    if strings.contains(zig_target, "macos"):
        return True
    return strings.endswith(zig_target, "-linux-gnu")

class Binary:
    # Single binary that we need to build
    main_file: str
    name: str
    out_dir: str
    args_link: Array[str]
    cpp: bool
    sources: Array[str]
    windows_args_link: Array[str]
    linux_args_link: Array[str]
    macos_args_link: Array[str]

class HammerConfig:
    # [compilation]
    targets: Array[str]
    args_c_or_cpp: Array[str]
    args_cpp: Array[str]
    args_c: Array[str]
    include_paths: Array[str]
    sources: Array[str]
    temp_out_dir: str
    binaries: Array[Binary]
    # Additional information
    zig: str
    errors: Array[str]
    disable_parallel: bool

def find_zig_compiler(c: HammerConfig) -> None:
    # Find zig(.exe) binary file
    zig: str = os.which("zig")
    if len(zig) > 0:
        c.zig = zig
        return
    arrput(c.errors, "Failed to find zig in PATH")
    c.zig = "<not found>"

def load_binary(t: toml.Table, c: HammerConfig, binary_name: str) -> Binary:
    b: Binary = Binary()
    if not toml.valid_table(t):
        arrput(c.errors, "Failed to load binary data from config: " + binary_name)
        return b
    b.args_link = toml.get_string_array(t, "args_link")
    b.name = toml.get_string_default(t, "name", binary_name)
    b.out_dir = toml.get_string_default(t, "out_dir", ".")
    b.main_file = toml.get_string_default(t, "main_file", "")
    b.sources = toml.get_string_array(t, "sources")
    b.windows_args_link = toml.get_string_array(t, "windows_args_link")
    b.linux_args_link = toml.get_string_array(t, "linux_args_link")
    b.macos_args_link = toml.get_string_array(t, "macos_args_link")
    if len(b.main_file) == 0:
        arrput(c.errors, "Empty main file for: " + binary_name)
    b.cpp = strings.endswith(b.main_file, ".cpp")
    return b

def load() -> HammerConfig:
    c: HammerConfig = HammerConfig()
    find_zig_compiler(c)
    if len(c.errors) > 0:
        return c
    config_file: str = path.join(os.cwd(), "hammer.toml")
    config_text: str = io.readfile(config_file)
    outer_table: toml.Table = toml.from_str(config_text)
    if not toml.valid_table(outer_table):
        arrput(c.errors, "Failed to read config file: " + config_file)
        return c
    defer toml.del_table(outer_table)
    table: toml.Table = toml.get_table(outer_table, "compilation")
    if not toml.valid_table(table):
        arrput(c.errors, "Failed to read config file: " + config_file)
        return c
    c.targets = toml.get_string_array(table, "targets")
    c.args_c_or_cpp = toml.get_string_array(table, "args_c_or_cpp")
    c.args_cpp = toml.get_string_array(table, "args_cpp")
    c.args_c = toml.get_string_array(table, "args_c")
    c.include_paths = toml.get_string_array(table, "include_paths")
    c.sources = toml.get_string_array(table, "sources")
    c.temp_out_dir = toml.get_string_default(table, "temp_out_dir", ".")
    c.disable_parallel = toml.get_bool_default(table, "disable_parallel", False)
    binaries: Array[str] = toml.get_string_array(table, "binaries")
    length: int = len(binaries)
    pos: int = 0
    while pos < length:
        binary: str = binaries[pos]
        binary_table: toml.Table = toml.get_table(outer_table, binary)
        arrput(c.binaries, load_binary(binary_table, c, binary))
        pos = pos + 1
    sarr.del_str_array(binaries)
    return c

def del_binary(b: Binary) -> None:
    sarr.del_str_array(b.args_link)
    sarr.del_str_array(b.sources)
    sarr.del_str_array(b.windows_args_link)
    sarr.del_str_array(b.linux_args_link)
    sarr.del_str_array(b.macos_args_link)
    del b.main_file
    del b.name
    del b.out_dir
    del b

def del_config(c: HammerConfig) -> None:
    sarr.del_str_array(c.targets)
    sarr.del_str_array(c.args_c_or_cpp)
    sarr.del_str_array(c.args_cpp)
    sarr.del_str_array(c.args_c)
    sarr.del_str_array(c.include_paths)
    sarr.del_str_array(c.sources)
    del c.temp_out_dir
    # Cleanup c.binaries
    if c.binaries != None:
        length: int = len(c.binaries)
        index: int = 0
        while index < length:
            del_binary(c.binaries[index])
            index = index + 1
        del c.binaries
    del c.zig
    sarr.del_str_array(c.errors)
    # clean up iteself
    del c
